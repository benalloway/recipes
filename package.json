{
  "name": "recipes",
  "version": "1.0.0",
  "description": "Insanely lightweight recipe app — Astro 7 + Cloudflare Workers/D1/R2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply recipes-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply recipes-db --remote",
    "check": "astro sync && tsc --noEmit",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "astro build",
    "ui:sync": "bash scripts/sync-ui.sh",
    "sandcastle": "npx tsx .sandcastle/main.ts",
    "sandcastle:gh": "gh workflow run sandcastle.yml && sleep 2 && gh run watch",
    "sandcastle:gh:pr": "gh workflow run sandcastle.yml -f delivery=pr && sleep 2 && gh run watch",
    "db:seed:local": "wrangler d1 execute recipes-db --local --file scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute recipes-db --remote --file scripts/seed.sql"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benalloway/recipes.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/benalloway/recipes/issues"
  },
  "homepage": "https://github.com/benalloway/recipes#readme",
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "wrangler": "^4.147.0",
    "zod": "^4.6.5"
  }
}
