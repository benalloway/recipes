{
  "name": "recipes",
  "version": "1.0.0",
  "description": "Insanely lightweight recipe app \u2014 Astro 7 + Cloudflare Workers/D1/R2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json --domain recipes.benalloway.com",
    "db:migrate:local": "wrangler d1 migrations apply recipes-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply recipes-db --remote",
    "check": "astro sync && tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benalloway/recipes.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/benalloway/recipes/issues"
  },
  "homepage": "https://github.com/benalloway/recipes#readme",
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "7.0.2",
    "wrangler": "^4.147.0"
  }
}
