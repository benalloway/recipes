# OpenCode API key (optional locally if `opencode auth login` is already configured;
# required in GitHub Actions repository secrets as OPENCODE_API_KEY)
OPENCODE_API_KEY=

# GitHub personal access token (optional locally if `gh auth login` is already configured;
# in GitHub Actions, GITHUB_TOKEN or SANDCASTLE_GH_TOKEN is used automatically)
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Contents (RW), Issues (RW), Pull requests (RW), Metadata (R)
GH_TOKEN=

# Optional overrides:
# SANDCASTLE_SANDBOX=local
# SANDCASTLE_MODEL=opencode/muse-spark-1.3-contributor-free
# SANDCASTLE_MAX_ITERATIONS=10
