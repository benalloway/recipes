{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipes",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "recipes-db", "database_id": "TODO_CREATE_VIA_WRANGLER" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "recipes-media" }
  ],
  "observability": { "enabled": true }
}
