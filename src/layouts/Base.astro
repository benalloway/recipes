---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = Astro.locals.session;

const navLink = 'font-sans text-xs uppercase tracking-[0.2em] text-accent';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Recipes</title>
  </head>
  <body>
    <header class="border-b border-hairline">
      <nav aria-label="Primary" class="mx-auto flex max-w-xl items-baseline justify-between px-6 py-4">
        <a href="/" class="text-[10px] font-medium uppercase tracking-[0.28em] text-ink">Recipes</a>
        <div class="flex items-center gap-5">
          <a href="/" class={navLink}>Recipes</a>
          <a href="/favorites" class={navLink}>
            Favorites
          </a>
          <a href="/recipes/new" class={navLink}>New</a>
          {
            session ? (
              <form method="post" action="/auth/logout" class="m-0">
                <button
                  type="submit"
                  class="cursor-pointer border-0 bg-transparent p-0 font-sans text-xs uppercase tracking-[0.2em] text-muted"
                >
                  Log out
                </button>
              </form>
            ) : (
              <a href="/login" class={navLink}>
                Sign in
              </a>
            )
          }
        </div>
      </nav>
    </header>
    <slot />
  </body>
</html>
