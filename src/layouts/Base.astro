---
import '../styles/global.css';
import { u } from '../lib/base';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = Astro.locals.session;
const pathname = Astro.url.pathname;

const sectionTabs = [
  { href: u('/'), label: 'Shelf' },
  { href: u('/favorites'), label: 'Favorites' },
];

const mobileMenuItems = [...sectionTabs, { href: u('/recipe/new'), label: '+ New Recipe' }];

function isActive(href: string) {
  if (href === u('/')) return pathname === href;
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={u('/favicon.ico')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <title>{title} — Recipes</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)',
          ).matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch {}
      })();
    </script>
  </head>
  <body class="bg-olive-100 font-sans text-olive-950 dark:bg-olive-950 dark:text-white">
    <header class="sticky top-0 z-10 border-b border-olive-950/10 bg-olive-100 dark:border-white/10 dark:bg-olive-950">
      <nav aria-label="Primary">
        <div class="mx-auto flex h-14 max-w-7xl items-center gap-2 px-4 sm:px-6 lg:px-10">
          <a
            href={u('/')}
            aria-label="Recipes — Home"
            class="inline-flex min-h-11 items-center gap-2 font-display text-lg tracking-tight whitespace-nowrap text-olive-950 transition hover:opacity-70 dark:text-white"
          >
            <span aria-hidden="true" class="inline-flex size-6 items-center justify-center rounded-full bg-olive-950 text-[13px] text-white dark:bg-olive-300 dark:text-olive-950">R</span>
            Recipes
          </a>

          <div class="ml-2 hidden items-center gap-1 sm:flex" aria-label="App sections">
            {
              sectionTabs.map((item) => {
                const active = isActive(item.href);
                return (
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'inline-flex min-h-9 items-center rounded-full px-3 text-sm/6 font-medium whitespace-nowrap transition',
                      active
                        ? 'bg-olive-950 text-white dark:bg-olive-300 dark:text-olive-950'
                        : 'text-olive-950/70 hover:bg-olive-950/5 hover:text-olive-950 dark:text-white/70 dark:hover:bg-white/10 dark:hover:text-white',
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })
            }
          </div>

          <div class="flex flex-1 items-center justify-end gap-1.5">
            <a
              href={u('/recipe/new')}
              class="inline-flex min-h-9 items-center rounded-full bg-olive-950 px-3.5 py-1.5 text-sm/6 font-medium whitespace-nowrap text-white transition hover:bg-olive-800 dark:bg-olive-300 dark:text-olive-950 dark:hover:bg-olive-200"
            >
              <span aria-hidden="true" class="mr-1">+</span> New<span class="hidden md:inline">&nbsp;Recipe</span>
            </a>

            <div class="hidden sm:block">
              {
                session ? (
                  <span
                    title={session.email}
                    class="inline-flex min-h-9 max-w-44 items-center truncate rounded-full bg-olive-950/6 px-3 text-sm/6 font-medium text-olive-950 dark:bg-white/8 dark:text-white"
                  >
                    {session.email}
                  </span>
                ) : (
                  <a
                    href={u('/login')}
                    class="inline-flex min-h-9 items-center rounded-full px-3 py-1.5 text-sm/6 font-medium whitespace-nowrap text-olive-950 transition hover:bg-olive-950/10 dark:text-white dark:hover:bg-white/10"
                  >
                    Sign in
                  </a>
                )
              }
            </div>

            <button
              type="button"
              data-theme-toggle
              aria-label="Toggle color theme"
              class="relative inline-flex size-9 items-center justify-center rounded-full text-olive-950 transition hover:bg-olive-950/10 active:scale-[0.98] dark:text-white dark:hover:bg-white/10"
            >
              <span
                class="absolute top-1/2 left-1/2 size-[max(100%,2.75rem)] -translate-x-1/2 -translate-y-1/2 pointer-fine:hidden"
                aria-hidden="true"></span>
              <svg
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="size-5 fill-olive-950/5 stroke-current transition dark:hidden"
              >
                <path d="M8 12.25A4.25 4.25 0 0 1 12.25 8v0a4.25 4.25 0 0 1 4.25 4.25v0a4.25 4.25 0 0 1-4.25 4.25v0A4.25 4.25 0 0 1 8 12.25v0Z"></path>
                <path
                  d="M12.25 3v1.5M21.5 12.25H20M18.791 18.791l-1.06-1.06M18.791 5.709l-1.06 1.06M12.25 20v1.5M4.5 12.25H3M6.77 6.77 5.709 5.709M6.77 17.73l-1.061 1.061"
                  fill="none"></path>
              </svg>
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="hidden size-5 fill-current transition dark:block"
              >
                <path
                  d="M17.25 16.22a6.937 6.937 0 0 1-9.47-9.47 7.451 7.451 0 1 0 9.47 9.47ZM12.75 7C17 7 17 2.75 17 2.75S17 7 21.25 7C17 7 17 11.25 17 11.25S17 7 12.75 7Z"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>

            <button
              type="button"
              data-mobile-menu-open
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="mobile-nav-dialog"
              aria-label="Open navigation menu"
              class="relative inline-flex size-9 items-center justify-center rounded-full text-olive-950 transition hover:bg-olive-950/10 active:scale-[0.98] sm:hidden dark:text-white dark:hover:bg-white/10"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5">
                <path
                  fill-rule="evenodd"
                  d="M3.748 8.248a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75ZM3.748 15.75a.75.75 0 0 1 .75-.751h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Z"
                  clip-rule="evenodd"></path>
              </svg>
            </button>
          </div>
        </div>

        <dialog
          id="mobile-nav-dialog"
          aria-label="Mobile navigation"
          class="fixed inset-0 z-50 m-0 h-full w-full max-h-none max-w-none bg-transparent p-0 backdrop:bg-transparent"
        >
          <div
            data-mobile-menu-panel
            class="fixed inset-0 bg-olive-100 px-6 py-6 lg:px-10 dark:bg-olive-950"
          >
            <div class="flex justify-end">
              <button
                type="button"
                data-mobile-menu-close
                aria-label="Close navigation menu"
                class="relative inline-flex size-12 items-center justify-center rounded-full text-olive-950 transition hover:bg-olive-950/10 dark:text-white dark:hover:bg-white/10"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  aria-hidden="true"
                  class="size-6"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            <nav aria-label="Mobile" class="mt-6">
              <div class="flex flex-col gap-2">
                {
                  mobileMenuItems.map((item) => {
                    const active = isActive(item.href);
                    return (
                      <a
                        href={item.href}
                        aria-current={active ? 'page' : undefined}
                        class:list={[
                          'group inline-flex min-h-12 items-center justify-between gap-2 text-3xl/10 font-medium transition',
                          active
                            ? 'text-olive-950 dark:text-white'
                            : 'text-olive-950/80 hover:text-olive-950 dark:text-white/80 dark:hover:text-white',
                        ]}
                      >
                        <span>{item.label}</span>
                        <span
                          class="inline-flex p-1.5 opacity-0 transition group-hover:opacity-100"
                          aria-hidden="true"
                        >
                          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                          </svg>
                        </span>
                      </a>
                    );
                  })
                }
                <div class="mt-4 border-t border-olive-950/10 pt-6 dark:border-white/10">
                  {
                    session ? (
                      <div class="flex flex-col gap-4">
                        <span class="truncate text-xl font-medium text-olive-950/80 dark:text-white/80">
                          {session.email}
                        </span>
                        <form method="post" action={u('/auth/logout')} class="m-0">
                          <button
                            type="submit"
                            class="inline-flex min-h-12 cursor-pointer items-center text-3xl/10 font-medium text-olive-950/80 dark:text-white/80"
                          >
                            Log out
                          </button>
                        </form>
                      </div>
                    ) : (
                      <a
                        href={u('/login')}
                        class="inline-flex min-h-12 items-center text-3xl/10 font-medium text-olive-950 dark:text-white"
                      >
                        Sign in
                      </a>
                    )
                  }
                </div>
              </div>
            </nav>
          </div>
        </dialog>
      </nav>
    </header>
    <main class="isolate overflow-clip">
      <slot />
    </main>
    <footer class="mt-16 border-t border-olive-950/10 dark:border-white/10">
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 text-sm text-olive-950/60 sm:px-6 lg:px-10 dark:text-white/60">
        <span>Recipes — your shelf</span>
        <a
          href="https://benalloway.com"
          class="inline-flex min-h-11 items-center transition hover:text-olive-950 hover:opacity-70 dark:hover:text-white"
        >
          benalloway.com&nbsp;<span aria-hidden="true">↗</span>
        </a>
      </div>
    </footer>
    <script src="../components/site-nav.ts"></script>
  </body>
</html>
