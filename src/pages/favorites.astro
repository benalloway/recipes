---
import Base from '../layouts/Base.astro';
import EmptyState from '../components/EmptyState.astro';
import RecipeGrid from '../components/RecipeGrid.astro';
import { getDb } from '../lib/adapters/db';
import { listFavorites } from '../lib/recipes';

const session = Astro.locals.session;
const cards = session ? await listFavorites(getDb(Astro.locals), session.userId) : [];
---

<Base title="Favorites">
  <main class="mx-auto max-w-4xl px-6 py-20">
    <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-muted">
      <a href="/" class="text-accent">
        ← Recipes
      </a>
    </p>
    <h1 class="mt-4 text-2xl font-light tracking-tight">Favorites</h1>
    {
      cards.length > 0 ? (
        <RecipeGrid cards={cards} />
      ) : (
        <EmptyState>
          <p class="font-hand text-lg text-ink">No favorites yet — tap the star on any recipe to keep it here.</p>
          <p class="mt-4 flex gap-6">
            <a href="/" class="font-sans text-xs uppercase tracking-[0.2em] text-accent">
              Browse recipes →
            </a>
            <a href="/recipes/new" class="font-sans text-xs uppercase tracking-[0.2em] text-accent">
              Add a recipe →
            </a>
          </p>
        </EmptyState>
      )
    }
  </main>
</Base>
