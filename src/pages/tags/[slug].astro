---
import Base from '../../layouts/Base.astro';
import Container from '../../components/ui/Container.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
import RecipeGrid from '../../components/RecipeGrid.astro';
import { u } from '../../lib/base';
import { getDb } from '../../lib/adapters/db';
import { getTagBySlug, listByTag } from '../../lib/recipes';

const session = Astro.locals.session;
const slug = Astro.params.slug ?? '';
const db = getDb(Astro.locals);
const tag = session ? await getTagBySlug(db, slug) : null;
const cards = session && tag ? await listByTag(db, session.userId, slug) : null;
if (cards === null) {
  Astro.response.status = 404;
}
---

{
  cards === null ? (
    <Base title="Not found">
      <Container class="mt-12 sm:mt-16">
        <p class="mb-2 text-sm/7 font-semibold text-olive-700 dark:text-olive-400">404 — Not found</p>
        <PageHeader title="Not found" intro="No such tag." />
        <p class="mt-6">
          <a
            href={u('/')}
            class="inline-flex min-h-11 items-center rounded-full bg-olive-950/10 px-4 py-2 text-sm/7 font-medium text-olive-950 transition hover:bg-olive-950/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/15"
          >
            ← Back to recipes
          </a>
        </p>
      </Container>
    </Base>
  ) : (
    <Base title={tag?.name ?? 'Tag'}>
      <Container class="mt-12 sm:mt-16">
        <p class="mb-2 text-sm/7 font-semibold text-olive-700 dark:text-olive-400">
          <a href={u('/')} class="transition hover:opacity-60">
            ← Recipes
          </a>
        </p>
        <PageHeader title={tag?.name ?? 'Tag'} />
        {cards.length > 0 ? (
          <RecipeGrid cards={cards} />
        ) : (
          <EmptyState>
            <p class="font-display text-2xl text-olive-950 dark:text-white">
              Nothing shelved under this tag yet.
            </p>
            <p class="mt-4 flex flex-wrap gap-3">
              <a
                href={u('/')}
                class="inline-flex min-h-11 items-center rounded-full bg-olive-950/10 px-4 py-2 text-sm/7 font-medium text-olive-950 transition hover:bg-olive-950/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/15"
              >
                Browse recipes →
              </a>
              <a
                href={u('/recipe/new')}
                class="inline-flex min-h-11 items-center rounded-full bg-olive-950/10 px-4 py-2 text-sm/7 font-medium text-olive-950 transition hover:bg-olive-950/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/15"
              >
                Add a recipe →
              </a>
            </p>
          </EmptyState>
        )}
      </Container>
    </Base>
  )
}
