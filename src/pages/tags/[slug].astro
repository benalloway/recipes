---
import Base from '../../layouts/Base.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getDb } from '../../lib/adapters/db';
import { listByTag } from '../../lib/recipes';

const session = Astro.locals.session;
const slug = Astro.params.slug ?? '';
const cards = session ? await listByTag(getDb(Astro.locals), session.userId, slug) : [];
if (cards === null) {
  Astro.response.status = 404;
}
const heading =
  cards === null
    ? null
    : ((await getDb(Astro.locals)
        .prepare('SELECT name FROM tags WHERE slug = ?')
        .bind(slug)
        .first<{ name: string }>())?.name ?? slug);
---

{
  cards === null ? (
    <Base title="Not found">
      <main class="mx-auto max-w-xl px-6 py-16">
        <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-muted">404 — Not found</p>
        <h1 class="mt-4 text-2xl font-light tracking-tight">Not found</h1>
        <p class="mt-2 text-ink">No such tag.</p>
        <p class="mt-4">
          <a href="/" class="text-xs uppercase tracking-[0.2em] text-accent">
            ← Back to recipes
          </a>
        </p>
      </main>
    </Base>
  ) : (
    <Base title={heading ?? 'Tag'}>
      <main class="mx-auto max-w-xl px-6 py-16">
        <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-muted">
          <a href="/" class="text-accent">
            ← Recipes
          </a>
        </p>
        <h1 class="mt-4 text-2xl font-light tracking-tight">{heading}</h1>
        <div class="mt-8 grid gap-6">
          {cards.map((card) => (
            <RecipeCard card={card} />
          ))}
        </div>
      </main>
    </Base>
  )
}
