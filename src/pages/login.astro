---
import Base from '../layouts/Base.astro';

if (Astro.locals.session) {
  return Astro.redirect('/', 302);
}

const params = Astro.url.searchParams;
const sent = params.get('sent') === 'ok';
const error = params.get('error');

const ERRORS: Record<string, string> = {
  invalid: 'Enter a valid email address.',
  link: 'That sign-in link is invalid, expired, or already used. Send a fresh one below.',
  email: 'We could not send the email. Try again in a minute.',
};
const errorMessage = error ? (ERRORS[error] ?? 'Something went wrong. Try again.') : null;
---

<Base title="Sign in">
  <main class="mx-auto flex min-h-dvh w-full max-w-[26rem] flex-col justify-center px-6">
    <section class="border border-hairline bg-surface px-8 py-10">
      <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-muted">Recipes</p>
      <h1 class="mt-3 text-2xl font-light tracking-tight">Sign in</h1>

      {
        errorMessage && (
          <div class="mt-6 border-t border-hairline pt-6">
            <p class="text-[10px] uppercase tracking-[0.28em] text-muted">Couldn&rsquo;t sign you in</p>
            <p class="mt-2 text-sm text-ink">{errorMessage}</p>
          </div>
        )
      }

      {
        sent ? (
          <div class="mt-6 border-t border-hairline pt-6">
            <p class="text-[10px] uppercase tracking-[0.28em] text-accent">Check your email</p>
            <p class="mt-2 text-sm text-ink">
              We sent a sign-in link. It expires in 15 minutes and works once.
            </p>
            <p class="mt-6 text-sm">
              <a href="/login">Use a different email</a>
            </p>
          </div>
        ) : (
          <div class="mt-8">
            <div class="flex gap-6 border-b border-hairline">
              <span class="border-b border-ink pb-2 font-sans text-xs uppercase tracking-[0.2em] text-ink">
                Email
              </span>
              <span
                class="cursor-not-allowed pb-2 font-sans text-xs uppercase tracking-[0.2em] text-muted"
                title="Phone sign-in is coming soon"
              >
                Phone
                <span class="ml-2 border border-hairline px-1 text-[9px] uppercase tracking-[0.2em]">
                  soon
                </span>
              </span>
            </div>

            <form action="/auth/request" method="post" class="mt-6">
              <label
                for="email"
                class="text-[10px] font-medium uppercase tracking-[0.28em] text-muted"
              >
                Email address
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                maxlength="320"
                autocomplete="email"
                placeholder="you@example.com"
                class="mt-2 w-full border-0 border-b border-hairline bg-transparent py-3 font-sans text-base text-ink outline-none placeholder:text-muted focus:border-accent"
              />
              <button
                type="submit"
                class="mt-8 w-full cursor-pointer border border-ink bg-ink py-3 font-sans text-xs uppercase tracking-[0.2em] text-bg hover:opacity-90"
              >
                Email me a sign-in link
              </button>
            </form>
          </div>
        )
      }
    </section>
    <p class="mt-6 text-center text-[10px] uppercase tracking-[0.28em] text-muted">
      Links expire in 15 minutes · Sessions last 30 days
    </p>
  </main>
</Base>
