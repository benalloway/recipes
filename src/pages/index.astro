---
import Base from '../layouts/Base.astro';
import EmptyState from '../components/EmptyState.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getDb } from '../lib/adapters/db';
import { getDashboard } from '../lib/recipes';

const session = Astro.locals.session;
const cards = session ? await getDashboard(getDb(Astro.locals), session.userId) : [];
const isEmpty = !!session && cards.length === 0;
---

<Base title="Home">
  <main class="mx-auto max-w-xl px-6 py-16">
    {
      session && (
        <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-muted">
          Signed in as {session.email}
        </p>
      )
    }
    <h1 class="mt-4 text-2xl font-light tracking-tight">Recipes</h1>
    {session && cards.length > 0 && (
      <div class="mt-8 grid gap-6">
        {cards.map((card) => (
          <RecipeCard card={card} />
        ))}
      </div>
    )}
    {!session && (
      <EmptyState>
        <p class="text-ink">Your recipes live here once you sign in.</p>
        <p class="mt-4">
          <a href="/login" class="font-sans text-xs uppercase tracking-[0.2em] text-accent">
            Sign in to get started →
          </a>
        </p>
      </EmptyState>
    )}
    {isEmpty && (
      <EmptyState>
        <p class="text-ink">No recipes yet — your shelf is ready when you are.</p>
        <p class="mt-4">
          <a href="/recipes/new" class="font-sans text-xs uppercase tracking-[0.2em] text-accent">
            Add your first recipe →
          </a>
        </p>
      </EmptyState>
    )}
  </main>
</Base>
