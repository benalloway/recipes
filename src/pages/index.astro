---
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getDb } from '../lib/adapters/db';
import { getDashboard } from '../lib/recipes';

const session = Astro.locals.session;
const cards = session ? await getDashboard(getDb(Astro.locals), session.userId) : [];
---

<Base title="Home">
  <main class="mx-auto max-w-xl px-6 py-16">
    {
      session && (
        <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-muted">
          Signed in as {session.email}
        </p>
      )
    }
    <h1 class="mt-4 text-2xl font-light tracking-tight">Recipes</h1>
    {
      cards.length > 0 ? (
        <div class="mt-8 grid gap-6">
          {cards.map((card) => (
            <RecipeCard card={card} />
          ))}
        </div>
      ) : (
        <div class="mt-8">
          <p class="text-ink">No recipes yet.</p>
          <p class="mt-2 text-muted">Add your first recipe at /recipes/new (arriving in #14).</p>
        </div>
      )
    }
    {
      session && (
        <form method="post" action="/auth/logout" class="mt-8 border-t border-hairline pt-4">
          <button
            type="submit"
            class="cursor-pointer border-0 bg-transparent p-0 font-sans text-xs uppercase tracking-[0.2em] text-accent"
          >
            Log out
          </button>
        </form>
      )
    }
  </main>
</Base>
