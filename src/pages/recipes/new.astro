---
import Base from '../../layouts/Base.astro';
import RecipeForm from '../../components/RecipeForm.astro';
import { getBlobs } from '../../lib/adapters/blobs';
import { getDb } from '../../lib/adapters/db';
import { readImageUpload, storeRecipeImage } from '../../lib/images';
import {
  blankRecipeFormValues,
  formStateForError,
  parseLinkedError,
  snapshotForRerender,
  type FormErrorCode,
  type RecipeFormField,
  type RecipeFormValues,
} from '../../lib/recipe-form';
import { createRecipe, INGREDIENT_FORM_ROWS, parseRecipeForm, RecipeValidationError } from '../../lib/recipes';

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/login', 302);
}

const db = getDb(Astro.locals);

let values: RecipeFormValues = blankRecipeFormValues();
let fieldErrors: Partial<Record<RecipeFormField, string>> = {};
let summaryError: string | null = null;

function showError(nextValues: RecipeFormValues, code: FormErrorCode): void {
  const state = formStateForError(nextValues, code);
  values = state.values;
  fieldErrors = state.fieldErrors;
  summaryError = state.summary;
}

if (Astro.request.method === 'POST') {
  let form: FormData;
  try {
    form = await Astro.request.formData();
  } catch {
    // Unreadable body: nothing to re-render, keep the deep-linkable code.
    return Astro.redirect('/recipes/new?error=unknown', 303);
  }
  const knownTagSlugs = new Set(
    (
      (await db.prepare('SELECT slug FROM tags').all<{ slug: string }>()).results ?? []
    ).map((row) => row.slug),
  );
  try {
    const input = parseRecipeForm(form, knownTagSlugs);
    const upload = await readImageUpload(form);
    const id = await createRecipe(db, session.userId, input);
    if (upload) {
      await storeRecipeImage(db, getBlobs(Astro.locals), id, upload);
    }
    return Astro.redirect(`/recipes/${id}`, 303);
  } catch (err) {
    if (err instanceof RecipeValidationError) {
      // Re-render with everything typed intact + an inline error (422).
      Astro.response.status = 422;
      showError(snapshotForRerender(form, INGREDIENT_FORM_ROWS), err.code);
    } else {
      throw err;
    }
  }
} else {
  // Deep-linkable `?error=` codes (validation copy lives in one place).
  const linkedError = parseLinkedError(Astro.url.searchParams.get('error'));
  if (linkedError) {
    showError(values, linkedError);
  }
}

const canonicalIngredients =
  ((await db.prepare('SELECT name FROM ingredients ORDER BY name LIMIT 500').all<{ name: string }>()).results ?? []).map(
    (row) => row.name,
  );
const allTags =
  ((await db.prepare('SELECT name, slug FROM tags ORDER BY name').all<{ name: string; slug: string }>()).results ??
    []);
---

<Base title="New recipe">
  <main class="mx-auto max-w-xl px-6 py-16">
    <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-muted">
      <a href="/" class="text-accent">
        ← Recipes
      </a>
    </p>
    <h1 class="mt-4 text-2xl font-light tracking-tight">New recipe</h1>
    <p class="mt-2 font-hand text-lg text-muted">Good recipes are written in pencil — taste as you go.</p>

    <RecipeForm
      action="/recipes/new"
      submitLabel="Save recipe"
      values={values}
      fieldErrors={fieldErrors}
      summaryError={summaryError}
      allTags={allTags}
      canonicalIngredients={canonicalIngredients}
      imageReplace={false}
    />
  </main>
</Base>
