---
import Base from '../../../layouts/Base.astro';
import RecipeForm from '../../../components/RecipeForm.astro';
import { getBlobs } from '../../../lib/adapters/blobs';
import { getDb } from '../../../lib/adapters/db';
import { readImageUpload, storeRecipeImage } from '../../../lib/images';
import {
  fieldForErrorCode,
  FORM_ERROR_MESSAGES,
  padIngredientRows,
  snapshotRecipeForm,
  valuesFromDetail,
  type FormErrorCode,
  type RecipeFormField,
  type RecipeFormValues,
} from '../../../lib/recipe-form';
import {
  appendVersion,
  getRecipeDetail,
  INGREDIENT_FORM_ROWS,
  parseRecipeForm,
  RecipeValidationError,
} from '../../../lib/recipes';

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/login', 302);
}

const db = getDb(Astro.locals);
const rawId = Astro.params.id ?? '';
const id = Number(rawId);
let postNotFound = false;

// Submitted values to re-render when validation fails (422, nothing wiped).
let failed: { values: RecipeFormValues; fieldErrors: Partial<Record<RecipeFormField, string>>; summary: string } | null =
  null;
// Deep-linkable `?error=` code for GETs (fresh POST failures take precedence).
let linkedError: FormErrorCode | null = null;

function toState(
  values: RecipeFormValues,
  code: FormErrorCode,
): {
  values: RecipeFormValues;
  fieldErrors: Partial<Record<RecipeFormField, string>>;
  summary: string;
} {
  const message = FORM_ERROR_MESSAGES[code];
  const field = fieldForErrorCode(code);
  return { values, fieldErrors: field ? { [field]: message } : {}, summary: message };
}

if (Astro.request.method === 'POST') {
  let form: FormData;
  try {
    form = await Astro.request.formData();
  } catch {
    // Unreadable body: nothing to re-render, keep the deep-linkable code.
    return Astro.redirect(`/recipes/${rawId}/edit?error=unknown`, 303);
  }
  const knownTagSlugs = new Set(
    (
      (await db.prepare('SELECT slug FROM tags').all<{ slug: string }>()).results ?? []
    ).map((row) => row.slug),
  );
  try {
    const input = parseRecipeForm(form, knownTagSlugs);
    const upload = await readImageUpload(form);
    const version = await appendVersion(db, session.userId, id, input);
    if (version === null) {
      Astro.response.status = 404;
      postNotFound = true;
    } else {
      if (upload) {
        await storeRecipeImage(db, getBlobs(Astro.locals), id, upload);
      }
      return Astro.redirect(`/recipes/${rawId}`, 303);
    }
  } catch (err) {
    if (err instanceof RecipeValidationError) {
      // Re-render with everything typed intact + an inline error (422).
      Astro.response.status = 422;
      const values = snapshotRecipeForm(form);
      values.ingredients = padIngredientRows(values.ingredients, INGREDIENT_FORM_ROWS);
      failed = toState(values, err.code);
    } else {
      throw err;
    }
  }
} else {
  const error = Astro.url.searchParams.get('error') as FormErrorCode | null;
  if (error && FORM_ERROR_MESSAGES[error]) {
    linkedError = error;
  }
}

const detail = postNotFound ? null : await getRecipeDetail(db, id, session.userId);
if (!detail) {
  Astro.response.status = 404;
}

const canonicalIngredients =
  ((await db.prepare('SELECT name FROM ingredients ORDER BY name LIMIT 500').all<{ name: string }>()).results ?? []).map(
    (row) => row.name,
  );
const allTags =
  ((await db.prepare('SELECT name, slug FROM tags ORDER BY name').all<{ name: string; slug: string }>()).results ??
    []);

// Fresh POST failure wins; otherwise the head version; otherwise the linked code.
const values: RecipeFormValues | null =
  failed?.values ?? (detail ? valuesFromDetail(detail) : null);
let fieldErrors: Partial<Record<RecipeFormField, string>> = failed?.fieldErrors ?? {};
let summaryError: string | null = failed?.summary ?? null;
if (!failed && linkedError && detail) {
  const message = FORM_ERROR_MESSAGES[linkedError];
  const field = fieldForErrorCode(linkedError);
  summaryError = message;
  fieldErrors = field ? { [field]: message } : {};
}
---

{
  !detail || !values ? (
    <Base title="Not found">
      <main class="mx-auto max-w-xl px-6 py-16">
        <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-muted">404 — Not found</p>
        <h1 class="mt-4 text-2xl font-light tracking-tight">Not found</h1>
        <p class="mt-2 text-ink">That recipe does not exist, was deleted, or belongs to someone else.</p>
        <p class="mt-4">
          <a href="/" class="text-xs uppercase tracking-[0.2em] text-accent">
            ← Back to recipes
          </a>
        </p>
      </main>
    </Base>
  ) : (
    <Base title={`Edit ${detail.title}`}>
      <main class="mx-auto max-w-xl px-6 py-16">
        <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-muted">
          <a href={`/recipes/${detail.id}`} class="text-accent">
            ← Back to recipe
          </a>
        </p>
        <h1 class="mt-4 text-2xl font-light tracking-tight">Edit recipe</h1>
        <p class="mt-2 font-hand text-lg text-muted">What changed? Future-you will thank you.</p>

        <RecipeForm
          action={`/recipes/${detail.id}/edit`}
          submitLabel="Save changes"
          values={values}
          fieldErrors={fieldErrors}
          summaryError={summaryError}
          allTags={allTags}
          canonicalIngredients={canonicalIngredients}
          imageReplace={true}
        />
      </main>
    </Base>
  )
}
