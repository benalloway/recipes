---
import Base from '../../../layouts/Base.astro';
import Container from '../../../components/ui/Container.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import RecipeForm from '../../../components/RecipeForm.astro';
import { u } from '../../../lib/base';
import { getBlobs } from '../../../lib/adapters/blobs';
import { getDb } from '../../../lib/adapters/db';
import { readImageUpload, storeRecipeImage } from '../../../lib/images';
import {
  formStateForError,
  parseLinkedError,
  snapshotForRerender,
  valuesFromDetail,
  type FormErrorCode,
  type RecipeFormState,
  type RecipeFormValues,
} from '../../../lib/recipe-form';
import {
  appendVersion,
  getRecipeDetail,
  INGREDIENT_FORM_ROWS,
  parseRecipeForm,
  RecipeValidationError,
} from '../../../lib/recipes';

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect(u('/login'), 302);
}

const db = getDb(Astro.locals);
const rawId = Astro.params.id ?? '';
const id = Number(rawId);
let postNotFound = false;

// Submitted values to re-render when validation fails (422, nothing wiped).
let failed: RecipeFormState | null = null;
// Deep-linkable `?error=` code for GETs (fresh POST failures take precedence).
let linkedError: FormErrorCode | null = null;

if (Astro.request.method === 'POST') {
  let form: FormData;
  try {
    form = await Astro.request.formData();
  } catch {
    // Unreadable body: nothing to re-render, keep the deep-linkable code.
    return Astro.redirect(u(`/recipes/${rawId}/edit?error=unknown`), 303);
  }
  const knownTagSlugs = new Set(
    (
      (await db.prepare('SELECT slug FROM tags').all<{ slug: string }>()).results ?? []
    ).map((row) => row.slug),
  );
  try {
    const input = parseRecipeForm(form, knownTagSlugs);
    const upload = await readImageUpload(form);
    const version = await appendVersion(db, session.userId, id, input);
    if (version === null) {
      Astro.response.status = 404;
      postNotFound = true;
    } else {
      if (upload) {
        await storeRecipeImage(db, getBlobs(Astro.locals), id, upload);
      }
      return Astro.redirect(u(`/recipes/${rawId}`), 303);
    }
  } catch (err) {
    if (err instanceof RecipeValidationError) {
      // Re-render with everything typed intact + an inline error (422).
      Astro.response.status = 422;
      failed = formStateForError(snapshotForRerender(form, INGREDIENT_FORM_ROWS), err.code);
    } else {
      throw err;
    }
  }
} else {
  linkedError = parseLinkedError(Astro.url.searchParams.get('error'));
}

const detail = postNotFound ? null : await getRecipeDetail(db, id, session.userId);
if (!detail) {
  Astro.response.status = 404;
}

const canonicalIngredients =
  ((await db.prepare('SELECT name FROM ingredients ORDER BY name LIMIT 500').all<{ name: string }>()).results ?? []).map(
    (row) => row.name,
  );
const allTags =
  ((await db.prepare('SELECT name, slug FROM tags ORDER BY name').all<{ name: string; slug: string }>()).results ??
    []);

// Fresh POST failure wins; otherwise the head version; otherwise the linked code.
const values: RecipeFormValues | null = failed?.values ?? (detail ? valuesFromDetail(detail) : null);
let fieldErrors: RecipeFormState['fieldErrors'] = failed?.fieldErrors ?? {};
let summaryError: string | null = failed?.summary ?? null;
if (!failed && linkedError && values) {
  const linked = formStateForError(values, linkedError);
  fieldErrors = linked.fieldErrors;
  summaryError = linked.summary;
}
---

{
  !detail || !values ? (
    <Base title="Not found">
      <Container class="mt-12 sm:mt-16">
        <div class="mx-auto max-w-2xl">
          <p class="mb-2 text-sm/7 font-semibold text-olive-700 dark:text-olive-400">404 — Not found</p>
          <PageHeader
            title="Not found"
            intro="That recipe does not exist, was deleted, or belongs to someone else."
          />
          <p class="mt-6">
            <a
              href={u('/')}
              class="inline-flex min-h-11 items-center rounded-full bg-olive-950/10 px-4 py-2 text-sm/7 font-medium text-olive-950 transition hover:bg-olive-950/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/15"
            >
              ← Back to recipes
            </a>
          </p>
        </div>
      </Container>
    </Base>
  ) : (
    <Base title={`Edit ${detail.title}`}>
      <Container class="mt-12 sm:mt-16">
        <div class="mx-auto max-w-2xl">
          <p class="mb-2 text-sm/7 font-semibold text-olive-700 dark:text-olive-400">
            <a href={u(`/recipes/${detail.id}`)} class="transition hover:opacity-60">
              ← Back to recipe
            </a>
          </p>
          <PageHeader
            title="Edit recipe"
            intro="What changed? Future-you will thank you."
          />

          <RecipeForm
            action={u(`/recipes/${detail.id}/edit`)}
          submitLabel="Save changes"
          values={values}
          fieldErrors={fieldErrors}
          summaryError={summaryError}
          allTags={allTags}
          canonicalIngredients={canonicalIngredients}
          imageReplace={true}
        />
        </div>
      </Container>
    </Base>
  )
}
