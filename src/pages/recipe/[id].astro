---
import Base from '../../layouts/Base.astro';
import Container from '../../components/ui/Container.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Plate from '../../components/Plate.astro';
import TagChip from '../../components/TagChip.astro';
import { u } from '../../lib/base';
import { getDb } from '../../lib/adapters/db';
import { formatIngredient, formatQuantity, getRecipeDetail } from '../../lib/recipes';

const session = Astro.locals.session;
const id = Number(Astro.params.id);
const detail = session ? await getRecipeDetail(getDb(Astro.locals), id, session.userId) : null;
if (!detail) {
  Astro.response.status = 404;
}

const jsonLd = detail
  ? {
      '@context': 'https://schema.org',
      '@type': 'Recipe',
      name: detail.title,
      recipeIngredient: detail.ingredients.map(formatIngredient),
      recipeInstructions: detail.instructions.map((text) => ({ '@type': 'HowToStep', text })),
      ...(detail.imageKey ? { image: u(`/media/${detail.imageKey}`) } : {}),
      ...(detail.servings !== null ? { recipeYield: formatQuantity(detail.servings) } : {}),
    }
  : null;
---

{
  detail ? (
    <Base title={detail.title}>
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
      <Container class="mt-12 sm:mt-16">
        <div class="mx-auto max-w-2xl">
          <p class="mb-2 text-sm/7 font-semibold text-olive-700 dark:text-olive-400">
            <a href={u('/')} class="transition hover:opacity-60">
              ← Recipes
            </a>
          </p>
          <h1 class="font-display text-5xl/12 tracking-tight text-balance text-olive-950 dark:text-white">
            {detail.title}
          </h1>
          <p class="mt-4 flex flex-wrap items-center gap-3 text-sm/7 text-olive-700 dark:text-olive-400">
            <a
              href={u(`/recipe/${detail.id}/edit`)}
              class="inline-flex min-h-11 items-center font-medium text-olive-950 underline decoration-olive-500/40 underline-offset-4 transition hover:opacity-60 dark:text-white"
            >
              Edit recipe
            </a>
            {detail.servings !== null && <span>· Serves {formatQuantity(detail.servings)}</span>}
          </p>
          {
            detail.imageKey && (
              <div class="mt-6">
                <Plate src={u(`/media/${detail.imageKey}`)} alt={detail.title} />
              </div>
            )
          }
          <h2 class="mt-10 text-sm/7 font-semibold text-olive-700 dark:text-olive-400">Ingredients</h2>
          <ul class="mt-2 space-y-1.5">
            {detail.ingredients.map((ingredient) => (
              <li class="text-base/7 text-olive-950 dark:text-white">{formatIngredient(ingredient)}</li>
            ))}
          </ul>
          <h2 class="mt-10 text-sm/7 font-semibold text-olive-700 dark:text-olive-400">Steps</h2>
          <ol class="mt-2 list-decimal space-y-2 pl-6">
            {detail.instructions.map((step) => (
              <li class="text-base/7 text-olive-950 dark:text-white">{step}</li>
            ))}
          </ol>
          {detail.tags.length > 0 && (
            <p class="mt-8 flex flex-wrap gap-1.5">
              {detail.tags.map((tag) => (
                <TagChip name={tag.name} slug={tag.slug} />
              ))}
            </p>
          )}
          <div class="mt-8 flex flex-wrap gap-3">
            <form method="post" action={u(`/recipe/${detail.id}/favorite`)} class="m-0">
              <button
                type="submit"
                aria-pressed={detail.isFavorite ? 'true' : 'false'}
                aria-label={detail.isFavorite ? 'Remove from favorites' : 'Save to favorites'}
                class="inline-flex min-h-11 cursor-pointer items-center gap-1.5 rounded-full bg-olive-950 px-4 py-2 text-sm/7 font-medium text-white transition hover:bg-olive-800 dark:bg-olive-300 dark:text-olive-950 dark:hover:bg-olive-200"
              >
                <span aria-hidden="true">{detail.isFavorite ? '★' : '☆'}</span>
                {detail.isFavorite ? 'Saved' : 'Save to favorites'}
              </button>
            </form>
            <form
              method="post"
              action={u(`/recipe/${detail.id}/delete`)}
              data-confirm={`Delete “${detail.title}”? This hides the recipe everywhere; history is kept.`}
              class="m-0"
            >
              <button
                type="submit"
                class="inline-flex min-h-11 cursor-pointer items-center rounded-full bg-olive-950/10 px-4 py-2 text-sm/7 font-medium text-olive-950 transition hover:bg-olive-950/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/15"
              >
                Delete recipe
              </button>
            </form>
          </div>
          <script>
            import '../../components/confirm-dialog.ts';
          </script>
        </div>
      </Container>
    </Base>
  ) : (
    <Base title="Not found">
      <Container class="mt-12 sm:mt-16">
        <div class="mx-auto max-w-2xl">
          <p class="mb-2 text-sm/7 font-semibold text-olive-700 dark:text-olive-400">404 — Not found</p>
          <PageHeader
            title="Not found"
            intro="That recipe does not exist, was deleted, or belongs to someone else."
          />
          <p class="mt-6">
            <a
              href={u('/')}
              class="inline-flex min-h-11 items-center rounded-full bg-olive-950/10 px-4 py-2 text-sm/7 font-medium text-olive-950 transition hover:bg-olive-950/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/15"
            >
              ← Back to recipes
            </a>
          </p>
        </div>
      </Container>
    </Base>
  )
}
