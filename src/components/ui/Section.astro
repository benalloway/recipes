---
interface Props {
  title: string;
}

const { title } = Astro.props;
const id = title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<section
  aria-labelledby={id}
  class="md:border-l md:border-olive-950/10 md:pl-6 md:dark:border-white/10"
>
  <div class="grid max-w-3xl grid-cols-1 items-baseline gap-y-8 md:grid-cols-4">
    <h2 id={id} class="text-sm/7 font-semibold text-olive-950 dark:text-white">
      {title}
    </h2>
    <div class="md:col-span-3">
      <slot />
    </div>
  </div>
</section>
