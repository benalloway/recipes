---
/**
 * Catalyst-style field wrapper: label + control slot + hint + inline error.
 * Pair with TextInput/TextareaInput/SelectInput via matching `id` / `forId`
 * and `errorId` so `aria-describedby` stays wired for server re-renders.
 */
interface Props {
  label: string;
  forId: string;
  hint?: string;
  error?: string;
  errorId?: string;
  required?: boolean;
  class?: string;
}

const { label, forId, hint, error, errorId, required = false, class: className = '' } = Astro.props;
const describedIds = [hint ? `${forId}-hint` : null, error && errorId ? errorId : null]
  .filter(Boolean)
  .join(' ');
---

<div class:list={['mt-8 first:mt-0', className]}>
  <label for={forId} class="block text-sm/7 font-medium text-olive-950 dark:text-white">
    {label}
    {required && <span aria-hidden="true"> *</span>}
  </label>
  <div class="mt-2" data-field-control={describedIds || undefined}>
    <slot />
  </div>
  {hint && (
    <p id={`${forId}-hint`} class="mt-1.5 text-xs text-olive-700 dark:text-olive-400">
      {hint}
    </p>
  )}
  {error && (
    <p id={errorId ?? `${forId}-error`} role="alert" class="mt-1.5 text-sm/6 text-red-700 dark:text-red-400">
      {error}
    </p>
  )}
</div>
