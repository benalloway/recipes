---
interface Props {
  id: string;
  name: string;
  value?: string;
  placeholder?: string;
  required?: boolean;
  rows?: number;
  maxlength?: number;
  invalid?: boolean;
  describedby?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  id,
  name,
  value = '',
  placeholder,
  required = false,
  rows = 6,
  maxlength,
  invalid = false,
  describedby,
  ariaLabel,
  class: className = '',
} = Astro.props;
---

<textarea
  id={id}
  name={name}
  rows={rows}
  placeholder={placeholder}
  required={required || undefined}
  maxlength={maxlength}
  aria-invalid={invalid ? 'true' : undefined}
  aria-describedby={describedby || undefined}
  aria-label={ariaLabel || undefined}
  class:list={[
    'block min-h-12 w-full rounded-xl border bg-white px-3.5 py-2.5 text-base text-olive-950 placeholder:text-olive-500 focus:outline-hidden sm:text-sm dark:bg-olive-950 dark:text-white dark:placeholder:text-olive-500',
    invalid
      ? 'border-red-500 focus:border-red-500 focus:ring-2 focus:ring-red-500/20'
      : 'border-olive-950/10 focus:border-olive-600 focus:ring-2 focus:ring-olive-600/20 dark:border-white/10',
    className,
  ]}
>{value}</textarea>
