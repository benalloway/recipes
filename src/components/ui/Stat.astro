---
import type { HTMLAttributes } from 'astro/types';

/**
 * Oatmeal Stat block (stats-three-column-with-description.tsx) + Catalyst stat display.
 */
interface Props extends HTMLAttributes<'div'> {
  label: string;
  value: string | number;
  detail?: string;
  class?: string;
}

const { label, value, detail, class: className = '', ...rest } = Astro.props;
---

<div
  class:list={[
    'rounded-xl bg-olive-950/4 px-4 py-3 dark:bg-white/5',
    className,
  ]}
  {...rest}
>
  <div class="text-xs/5 font-medium text-olive-700 dark:text-olive-400">
    {label}
  </div>
  <div class="mt-0.5 font-display text-2xl/8 tracking-tight text-olive-950 dark:text-white">
    {value}
  </div>
  {
    detail && (
      <div class="mt-1 text-xs/5 text-olive-600 dark:text-olive-400">
        {detail}
      </div>
    )
  }
</div>
