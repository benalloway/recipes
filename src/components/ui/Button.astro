---
/**
 * Oatmeal Button elements (button.tsx) + MD3 TouchTarget expansion.
 * Variant names kept stable so pages don't churn: primary = Oatmeal
 * dark/light, secondary = Oatmeal soft, teal = primary alias.
 */
const variantStyles = {
  primary:
    'bg-olive-950 text-white hover:bg-olive-800 active:bg-olive-800 dark:bg-olive-300 dark:text-olive-950 dark:hover:bg-olive-200 dark:active:bg-olive-200',
  secondary:
    'bg-olive-950/10 text-olive-950 hover:bg-olive-950/15 active:bg-olive-950/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/20 dark:active:bg-white/20',
  teal:
    'bg-olive-950 text-white hover:bg-olive-800 active:bg-olive-800 dark:bg-olive-300 dark:text-olive-950 dark:hover:bg-olive-200 dark:active:bg-olive-200',
} as const;

interface Props {
  href?: string;
  variant?: keyof typeof variantStyles;
  size?: 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
} = Astro.props;

const sizeClass = size === 'lg' ? 'px-4 py-2' : 'px-3 py-1';
const baseClass =
  'relative isolate inline-flex min-h-11 shrink-0 items-center justify-center gap-1 rounded-full text-sm/7 font-medium transition active:transition-none';
---

{
  href ? (
    <a href={href} class:list={[baseClass, sizeClass, variantStyles[variant], className]}>
      <span
        class="absolute top-1/2 left-1/2 size-[max(100%,2.75rem)] -translate-x-1/2 -translate-y-1/2 pointer-fine:hidden"
        aria-hidden="true"
      />
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class:list={[baseClass, sizeClass, variantStyles[variant], className]}
    >
      <span
        class="absolute top-1/2 left-1/2 size-[max(100%,2.75rem)] -translate-x-1/2 -translate-y-1/2 pointer-fine:hidden"
        aria-hidden="true"
      />
      <slot />
    </button>
  )
}
