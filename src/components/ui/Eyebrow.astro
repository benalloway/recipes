---
import type { HTMLAttributes } from 'astro/types';

/**
 * Oatmeal Eyebrow (eyebrow.tsx).
 */
interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'p' | 'span';
  class?: string;
}

const { as: Tag = 'div', class: className = '', ...rest } = Astro.props;
---

<Tag
  class:list={['text-sm/7 font-semibold text-olive-700 dark:text-olive-400', className]}
  {...rest}
>
  <slot />
</Tag>
