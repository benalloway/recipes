---
import type { HTMLAttributes } from 'astro/types';

/**
 * Catalyst DescriptionList (description-list.tsx) themed with Oatmeal olive tokens.
 */
interface Props extends HTMLAttributes<'dl'> {
  class?: string;
}

const { class: className = '', ...rest } = Astro.props;
---

<dl
  class:list={[
    'grid grid-cols-1 text-base/6 sm:grid-cols-[min(45%,18rem)_auto] sm:text-sm/6',
    className,
  ]}
  {...rest}
>
  <slot />
</dl>
