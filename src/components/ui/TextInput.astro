---
import type { HTMLAttributes } from 'astro/types';

/**
 * Catalyst-style rounded-xl bordered text/search input (Astro-native, no JS).
 * Supports optional leading `icon="search"` and pass-through `data-*` attributes.
 */
interface Props extends HTMLAttributes<'input'> {
  id: string;
  name?: string;
  type?: 'text' | 'email' | 'password' | 'search' | 'tel' | 'url' | 'number';
  value?: string;
  placeholder?: string;
  required?: boolean;
  maxlength?: number;
  autocomplete?: string;
  inputmode?: 'text' | 'decimal' | 'numeric' | 'email' | 'search' | 'tel' | 'url';
  list?: string;
  invalid?: boolean;
  describedby?: string;
  ariaLabel?: string;
  icon?: 'search';
  class?: string;
}

const {
  id,
  name,
  type = 'text',
  value = '',
  placeholder,
  required = false,
  maxlength,
  autocomplete,
  inputmode,
  list,
  invalid = false,
  describedby,
  ariaLabel,
  icon,
  class: className = '',
  ...rest
} = Astro.props;

const inputClasses = [
  'block min-h-12 w-full rounded-xl border bg-white py-2.5 text-base text-olive-950 placeholder:text-olive-500 focus:outline-hidden sm:min-h-10 sm:text-sm dark:bg-olive-950 dark:text-white dark:placeholder:text-olive-500',
  icon === 'search' ? 'pr-4 pl-10' : 'px-3.5',
  invalid
    ? 'border-red-500 focus:border-red-500 focus:ring-2 focus:ring-red-500/20'
    : 'border-olive-950/10 focus:border-olive-600 focus:ring-2 focus:ring-olive-600/20 dark:border-white/10',
  className,
];
---

{
  icon === 'search' ? (
    <div class="relative">
      <svg
        viewBox="0 0 20 20"
        fill="none"
        aria-hidden="true"
        class="pointer-events-none absolute top-1/2 left-3.5 size-4 -translate-y-1/2 stroke-olive-500"
      >
        <path
          d="m17.5 17.5-3.625-3.625m1.958-4.708a6.667 6.667 0 1 1-13.333 0 6.667 6.667 0 0 1 13.333 0Z"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <input
        id={id}
        name={name}
        type={type}
        value={value}
        placeholder={placeholder}
        required={required || undefined}
        maxlength={maxlength}
        autocomplete={autocomplete}
        inputmode={inputmode}
        list={list}
        aria-invalid={invalid ? 'true' : undefined}
        aria-describedby={describedby || undefined}
        aria-label={ariaLabel || undefined}
        class:list={inputClasses}
        {...rest}
      />
    </div>
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      value={value}
      placeholder={placeholder}
      required={required || undefined}
      maxlength={maxlength}
      autocomplete={autocomplete}
      inputmode={inputmode}
      list={list}
      aria-invalid={invalid ? 'true' : undefined}
      aria-describedby={describedby || undefined}
      aria-label={ariaLabel || undefined}
      class:list={inputClasses}
      {...rest}
    />
  )
}
