---
import Eyebrow from './Eyebrow.astro';
import Heading from './Heading.astro';
import Text from './Text.astro';

/**
 * Standardized Oatmeal PageHeader (hero-simple-left-aligned.tsx).
 * Composes Eyebrow + Heading + Text + optional actions slot.
 */
interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
  class?: string;
}

const { title, intro, eyebrow, class: className = '' } = Astro.props;
---

<header class:list={['max-w-2xl', className]}>
  {eyebrow && <Eyebrow class="mb-2">{eyebrow}</Eyebrow>}
  <Heading level={1} size="display">
    {title}
  </Heading>
  {
    intro && (
      <Text as="div" size="lg" class="mt-6 text-pretty">
        {intro}
      </Text>
    )
  }
  <slot />
</header>
