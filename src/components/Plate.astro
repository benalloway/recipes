---
/**
 * Plate — user photo in a restrained Oatmeal frame: fixed 4:3 aspect,
 * rounded corners, hairline ring. Pass the recipe title as alt; pass
 * alt="" only for decorative thumbnails.
 */
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="m-0 overflow-hidden rounded-xl ring-1 ring-olive-950/10 dark:ring-white/10">
  <span class="relative block aspect-[4/3] w-full overflow-hidden bg-olive-950/5 dark:bg-white/5">
    <img src={src} alt={alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
  </span>
</figure>
