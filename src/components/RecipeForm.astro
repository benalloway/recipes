---
/**
 * Shared new/edit recipe form — Catalyst blocks on the @benalloway/ui
 * primitives (vendored in ./ui), MD3 touch targets throughout.
 *
 * Server re-renders with submitted `values` + inline `fieldErrors`
 * (never wipes input on validation failure). Ingredient rows are
 * dynamic via the `ingredient-rows.ts` island; without JS the
 * server-rendered rows post untouched. Submit sits in a sticky
 * bottom bar so it stays visible on small viewports.
 */
import Field from './ui/Field.astro';
import TextInput from './ui/TextInput.astro';
import TextareaInput from './ui/TextareaInput.astro';
import CheckboxItem from './ui/CheckboxItem.astro';
import FileInput from './ui/FileInput.astro';
import FormAlert from './ui/FormAlert.astro';
import SubmitBar from './ui/SubmitBar.astro';
import type { RecipeFormField, RecipeFormValues } from '../lib/recipe-form';

interface Props {
  action: string;
  submitLabel: string;
  values: RecipeFormValues;
  fieldErrors: Partial<Record<RecipeFormField, string>>;
  summaryError: string | null;
  allTags: { name: string; slug: string }[];
  canonicalIngredients: string[];
  imageReplace: boolean;
}

const {
  action,
  submitLabel,
  values,
  fieldErrors,
  summaryError,
  allTags,
  canonicalIngredients,
  imageReplace,
} = Astro.props;

const checkedSlugs = new Set(values.tagSlugs);

function describedBy(field: RecipeFormField): string | undefined {
  return fieldErrors[field] ? `${field}-error` : undefined;
}
---

{
  summaryError && (
    <div class="mt-6">
      <FormAlert message={summaryError} />
    </div>
  )
}

<form method="post" action={action} enctype="multipart/form-data" class="mt-8">
  <Field
    label="Title"
    forId="title"
    required
    error={fieldErrors.title}
    errorId="title-error"
  >
    <TextInput
      id="title"
      name="title"
      required
      maxlength={200}
      placeholder="Tomato soup"
      value={values.title}
      invalid={!!fieldErrors.title}
      describedby={describedBy('title')}
    />
  </Field>

  <Field
    label="Servings (blank for none)"
    forId="servings"
    error={fieldErrors.servings}
    errorId="servings-error"
  >
    <TextInput
      id="servings"
      name="servings"
      inputmode="decimal"
      placeholder="4"
      value={values.servings}
      invalid={!!fieldErrors.servings}
      describedby={describedBy('servings')}
    />
  </Field>

  <Field
    label="Instructions (one step per line)"
    forId="instructions"
    required
    error={fieldErrors.instructions}
    errorId="instructions-error"
  >
    <TextareaInput
      id="instructions"
      name="instructions"
      required
      rows={6}
      placeholder={'Chop\nSimmer'}
      value={values.instructions}
      invalid={!!fieldErrors.instructions}
      describedby={describedBy('instructions')}
    />
  </Field>

  <div class="mt-8">
    <h2 class="block text-sm/7 font-medium text-olive-950 dark:text-white">Ingredients</h2>
    {fieldErrors.ingredients && (
      <p id="ingredients-error" role="alert" class="mt-1.5 text-sm/6 text-red-700 dark:text-red-400">
        {fieldErrors.ingredients}
      </p>
    )}
    <datalist id="canonical-ingredients">
      {canonicalIngredients.map((name) => (
        <option value={name} />
      ))}
    </datalist>
    <div data-ingredient-rows data-next-index={values.ingredients.length} class="mt-2 space-y-3">
      {values.ingredients.map((row, i) => (
        <div
          data-ingredient-row
          class="grid grid-cols-2 gap-3 rounded-2xl border border-olive-950/10 bg-white/60 p-4 dark:border-white/10 dark:bg-white/5"
        >
          <input
            name={`ing-name-${i}`}
            type="text"
            maxlength="100"
            list="canonical-ingredients"
            placeholder="Ingredient"
            aria-label={`Ingredient ${i + 1} name`}
            value={row.name}
            class="col-span-2 block min-h-12 w-full rounded-xl border border-olive-950/10 bg-white px-3.5 py-2.5 text-base text-olive-950 placeholder:text-olive-500 focus:border-olive-600 focus:ring-2 focus:ring-olive-600/20 focus:outline-hidden sm:min-h-10 sm:text-sm dark:border-white/10 dark:bg-olive-950 dark:text-white dark:placeholder:text-olive-500"
          />
          <input
            name={`ing-qty-${i}`}
            type="text"
            inputmode="decimal"
            placeholder="Qty"
            aria-label={`Ingredient ${i + 1} quantity`}
            value={row.qty}
            class="block min-h-12 w-full rounded-xl border border-olive-950/10 bg-white px-3.5 py-2.5 text-base text-olive-950 placeholder:text-olive-500 focus:border-olive-600 focus:ring-2 focus:ring-olive-600/20 focus:outline-hidden sm:min-h-10 sm:text-sm dark:border-white/10 dark:bg-olive-950 dark:text-white dark:placeholder:text-olive-500"
          />
          <input
            name={`ing-unit-${i}`}
            type="text"
            maxlength="20"
            placeholder="Unit"
            aria-label={`Ingredient ${i + 1} unit`}
            value={row.unit}
            class="block min-h-12 w-full rounded-xl border border-olive-950/10 bg-white px-3.5 py-2.5 text-base text-olive-950 placeholder:text-olive-500 focus:border-olive-600 focus:ring-2 focus:ring-olive-600/20 focus:outline-hidden sm:min-h-10 sm:text-sm dark:border-white/10 dark:bg-olive-950 dark:text-white dark:placeholder:text-olive-500"
          />
          <input
            name={`ing-note-${i}`}
            type="text"
            maxlength="200"
            placeholder="Note (optional)"
            aria-label={`Ingredient ${i + 1} note`}
            value={row.note}
            class="col-span-2 block min-h-12 w-full rounded-xl border border-olive-950/10 bg-white px-3.5 py-2.5 text-base text-olive-950 placeholder:text-olive-500 focus:border-olive-600 focus:ring-2 focus:ring-olive-600/20 focus:outline-hidden sm:min-h-10 sm:text-sm dark:border-white/10 dark:bg-olive-950 dark:text-white dark:placeholder:text-olive-500"
          />
          <button
            type="button"
            data-remove-row
            hidden
            class="col-span-2 inline-flex min-h-11 cursor-pointer items-center justify-self-start rounded-full px-3 py-1 text-sm/7 font-medium text-olive-700 transition hover:bg-olive-950/5 dark:text-olive-300 dark:hover:bg-white/5"
          >
            Remove
          </button>
        </div>
      ))}
    </div>
    <button
      type="button"
      data-add-row
      hidden
      class="mt-4 inline-flex min-h-11 cursor-pointer items-center rounded-full bg-olive-950/10 px-4 py-2 text-sm/7 font-medium text-olive-950 transition hover:bg-olive-950/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/15"
    >
      + Add ingredient
    </button>
    <template data-row-template>
      <div
        data-ingredient-row
        class="grid grid-cols-2 gap-3 rounded-2xl border border-olive-950/10 bg-white/60 p-4 dark:border-white/10 dark:bg-white/5"
      >
        <input
          name="ing-name-__INDEX__"
          type="text"
          maxlength="100"
          list="canonical-ingredients"
          placeholder="Ingredient"
          aria-label="Ingredient __N__ name"
          class="col-span-2 block min-h-12 w-full rounded-xl border border-olive-950/10 bg-white px-3.5 py-2.5 text-base text-olive-950 placeholder:text-olive-500 focus:border-olive-600 focus:ring-2 focus:ring-olive-600/20 focus:outline-hidden sm:min-h-10 sm:text-sm dark:border-white/10 dark:bg-olive-950 dark:text-white dark:placeholder:text-olive-500"
        />
        <input
          name="ing-qty-__INDEX__"
          type="text"
          inputmode="decimal"
          placeholder="Qty"
          aria-label="Ingredient __N__ quantity"
          class="block min-h-12 w-full rounded-xl border border-olive-950/10 bg-white px-3.5 py-2.5 text-base text-olive-950 placeholder:text-olive-500 focus:border-olive-600 focus:ring-2 focus:ring-olive-600/20 focus:outline-hidden sm:min-h-10 sm:text-sm dark:border-white/10 dark:bg-olive-950 dark:text-white dark:placeholder:text-olive-500"
        />
        <input
          name="ing-unit-__INDEX__"
          type="text"
          maxlength="20"
          placeholder="Unit"
          aria-label="Ingredient __N__ unit"
          class="block min-h-12 w-full rounded-xl border border-olive-950/10 bg-white px-3.5 py-2.5 text-base text-olive-950 placeholder:text-olive-500 focus:border-olive-600 focus:ring-2 focus:ring-olive-600/20 focus:outline-hidden sm:min-h-10 sm:text-sm dark:border-white/10 dark:bg-olive-950 dark:text-white dark:placeholder:text-olive-500"
        />
        <input
          name="ing-note-__INDEX__"
          type="text"
          maxlength="200"
          placeholder="Note (optional)"
          aria-label="Ingredient __N__ note"
          class="col-span-2 block min-h-12 w-full rounded-xl border border-olive-950/10 bg-white px-3.5 py-2.5 text-base text-olive-950 placeholder:text-olive-500 focus:border-olive-600 focus:ring-2 focus:ring-olive-600/20 focus:outline-hidden sm:min-h-10 sm:text-sm dark:border-white/10 dark:bg-olive-950 dark:text-white dark:placeholder:text-olive-500"
        />
        <button
          type="button"
          data-remove-row
          class="col-span-2 inline-flex min-h-11 cursor-pointer items-center justify-self-start rounded-full px-3 py-1 text-sm/7 font-medium text-olive-700 transition hover:bg-olive-950/5 dark:text-olive-300 dark:hover:bg-white/5"
        >
          Remove
        </button>
      </div>
    </template>
  </div>

  <div class="mt-8">
    <h2 class="block text-sm/7 font-medium text-olive-950 dark:text-white">Tags</h2>
    <div class="mt-2 grid grid-cols-1 gap-1 sm:grid-cols-2">
      {allTags.map((tag) => (
        <CheckboxItem name="tags" value={tag.slug} label={tag.name} checked={checkedSlugs.has(tag.slug)} />
      ))}
    </div>
    <p class="mt-2 text-xs text-olive-700 dark:text-olive-400">Unknown tags are skipped.</p>
  </div>

  <Field
    label={imageReplace ? 'Photo (optional — replaces the current photo)' : 'Photo (optional)'}
    forId="image"
    error={fieldErrors.image}
    errorId="image-error"
  >
    <FileInput
      id="image"
      name="image"
      accept="image/jpeg,image/png,image/webp"
      describedby={fieldErrors.image ? 'image-error' : undefined}
      extraAttrs={{ 'data-image-input': '' }}
    />
  </Field>
  <script>
    import './image-input.ts';
  </script>

  <SubmitBar submitLabel={submitLabel} />
</form>

<script>
  import './ingredient-rows.ts';
</script>
