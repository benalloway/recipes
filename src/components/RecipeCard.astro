---
import type { RecipeCard as Card } from '../lib/recipes';
import { u } from '../lib/base';
import Plate from './Plate.astro';
import TagChip from './TagChip.astro';

interface Props {
  card: Card;
}

const { card } = Astro.props;
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-olive-950/10 bg-white p-5 shadow-xs transition hover:border-olive-950/20 hover:shadow-md dark:border-white/10 dark:bg-white/5 dark:hover:border-white/20">
  <h2 class="font-display text-2xl tracking-tight text-olive-950 transition group-hover:opacity-60 dark:text-white">
    <a href={u(`/recipe/${card.id}`)} class="focus:outline-hidden">
      <span class="absolute inset-0 z-10" aria-hidden="true"></span>
      {card.title}
    </a>
  </h2>
  {
    card.imageKey ? (
      <div class="mt-4">
        <Plate src={u(`/media/${card.imageKey}`)} alt={card.title} />
      </div>
    ) : (
      <div class="mt-4 h-32 rounded-xl bg-olive-950/5 dark:bg-white/5" aria-hidden="true" />
    )
  }
  {
    card.tags.length > 0 && (
      <p class="relative z-10 mt-4 flex flex-wrap gap-1.5">
        {card.tags.map((tag) => (
          <TagChip name={tag.name} slug={tag.slug} />
        ))}
      </p>
    )
  }
  <form method="post" action={u(`/recipe/${card.id}/favorite`)} class="relative z-10 mt-4">
    <button
      type="submit"
      aria-pressed={card.isFavorite ? 'true' : 'false'}
      aria-label={card.isFavorite ? 'Remove from favorites' : 'Save to favorites'}
      class="inline-flex min-h-11 cursor-pointer items-center gap-1.5 rounded-full bg-olive-950/5 px-3.5 py-1 text-sm/7 font-medium text-olive-950 transition hover:bg-olive-950/10 dark:bg-white/10 dark:text-white dark:hover:bg-white/15"
    >
      <span aria-hidden="true" class={card.isFavorite ? 'text-amber-500' : ''}>
        {card.isFavorite ? '★' : '☆'}
      </span>
      {card.isFavorite ? 'Saved' : 'Save'}
    </button>
  </form>
</article>
