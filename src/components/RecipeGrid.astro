---
import type { RecipeCard as Card } from '../lib/recipes';
import RecipeCard from './RecipeCard.astro';

interface Props {
  cards: Card[];
}

const { cards } = Astro.props;
---

<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
  {cards.map((card) => (
    <RecipeCard card={card} />
  ))}
</div>
